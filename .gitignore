ui/.env
.env
.env.local
.env.*.local

# ─── IDEs and Editors ────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.launch
*.sublime-workspace
*.sublime-project
.c9/
.history/

# VS Code — keep shared config, ignore personal workspace overrides
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── OS / System ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Temp / Upload scratch files ─────────────────────────────────────────────
# The backend writes uploaded files to the OS temp dir, but just in case
/tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Build output (generic) ──────────────────────────────────────────────────
out/
build/
