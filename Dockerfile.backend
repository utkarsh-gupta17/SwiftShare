FROM maven:3.9-openjdk-17-slim AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn clean package

FROM openjdk:17-slim
WORKDIR /app
COPY --from=build /build/target/swiftshare-1.0-SNAPSHOT.jar app.jar
COPY --from=build /build/target/dependency/*.jar ./lib/
EXPOSE 8080
# Dynamic P2P ports (49152–65535) are bound at runtime by FileSharer
CMD ["java", "-jar", "app.jar"]
